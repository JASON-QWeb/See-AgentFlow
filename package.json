{
  "name": "agent-view",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node server/index.mjs",
    "test": "node --test tests/collector.test.mjs tests/server.test.mjs tests/replay.test.mjs tests/retention.test.mjs tests/screensaver.test.mjs tests/preferences.test.mjs tests/i18n.test.mjs",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "build:saver": "npm run build && python3 macos/build.py",
    "build:dmg": "npm run build:saver && python3 macos/build_dmg.py",
    "test:installer": "node --test tests/installer.test.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test:native": "node scripts/test-native.mjs",
    "test:native-lock": "node scripts/test-native-lock.mjs",
    "test:docs": "node scripts/check-docs.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.5"
  }
}
